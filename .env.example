# Gemini API Key (Required for LLM calls)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Cloud Document AI Configuration
# If configured, Document AI will be used for OCR on scanned/unreadable documents
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# DOCAI_PROJECT_ID=your-gcp-project-id
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=your-processor-id
